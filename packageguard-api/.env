# Copy this file to .env and fill in real values
# For production (Render + Supabase) see DEPLOYMENT.md

# ── Environment ───────────────────────────────────────────────────────────────
NODE_ENV=production            # Set to 'production' on Render

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/packageguard
# Supabase (production) — get from Supabase > Settings > Database > URI:
DATABASE_URL=postgresql://postgres.nylwcgdrjvbutjyunqku:ixkXkdXhY5TJZYDk@aws-1-eu-central-1.pooler.supabase.com:6543/postgres

# ── JWT secrets — use long random strings in production ───────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=491c256139c7cd2e4956785d2ddb9efa9f59b781a4610227c0ccff88a4ed4009
JWT_REFRESH_SECRET=339cc077534e2c587cef20de03c1576ea509c420e35735f2a18627c1f3cdfdd5

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000

# Public base URL used to build verification links returned to the app.
# Local dev:
# PUBLIC_BASE_URL=http://localhost:4000
# Production (Render):
PUBLIC_BASE_URL=https://packageguard.onrender.com

# ── Supabase Storage (evidence photos) ───────────────────────────────────────
# Get from Supabase > Settings > API
SUPABASE_URL=https://nylwcgdrjvbutjyunqku.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im55bHdjZ2RyanZidXRqeXVucWt1Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc3MjU2NTEwNywiZXhwIjoyMDg4MTQxMTA3fQ.780bBwIaVbe5N4nH-2q3UiIpE4vk5a7tnhkQaWXjCXI   (Settings > API > service_role)
SUPABASE_STORAGE_BUCKET=evidence

# ── Email — SendGrid (omit key to use console stub) ───────────────────────────
SENDGRID_API_KEY=
EMAIL_FROM=noreply@packageguard.io
EMAIL_FROM_NAME=PackageGuard

# ── Optional AI image analysis (disabled by default) ──────────────────────────
AI_ANALYSIS_ENABLED=false
# AI_ANALYSIS_PROVIDER=anthropic    # 'anthropic' or 'openai'
# ANTHROPIC_API_KEY=sk-ant-...      # required if provider=anthropic
# OPENAI_API_KEY=sk-...             # required if provider=openai
