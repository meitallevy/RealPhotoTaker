# Copy this file to .env and fill in real values

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/packageguard

# Redis connection string (optional — used for session cache)
REDIS_URL=redis://localhost:6379

# JWT secrets — use long random strings in production
JWT_SECRET=dev_jwt_secret_change_me_in_prod
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_in_prod

# Server port (default 4000)
PORT=4000

# Public base URL used to build verification links returned to the app
# Use localhost:4000 for local dev; change to your server's IP/domain for real devices
PUBLIC_BASE_URL=http://localhost:4000

# Storage directories for uploaded evidence files
EVIDENCE_STORAGE_PATH=./storage/evidence
TEMP_STORAGE_PATH=./storage/temp
