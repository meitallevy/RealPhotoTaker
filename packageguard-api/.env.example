# Copy this file to .env and fill in real values
# For production (Render + Supabase) see DEPLOYMENT.md

# ── Environment ───────────────────────────────────────────────────────────────
NODE_ENV=development            # Set to 'production' on Render

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/packageguard
# Supabase (production) — get from Supabase > Settings > Database > URI:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ── JWT secrets — use long random strings in production ───────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=dev_jwt_secret_change_me_in_prod
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_in_prod

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000

# Public base URL used to build verification links returned to the app.
# Local dev:
PUBLIC_BASE_URL=http://localhost:4000
# Production (Render):
# PUBLIC_BASE_URL=https://YOUR-SERVICE-NAME.onrender.com

# ── Supabase Storage (evidence photos) ───────────────────────────────────────
# Get from Supabase > Settings > API
# SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   (Settings > API > service_role)
# SUPABASE_STORAGE_BUCKET=evidence                  (create this bucket in Storage tab)

# ── Email — SendGrid (omit key to use console stub) ───────────────────────────
SENDGRID_API_KEY=
EMAIL_FROM=noreply@packageguard.io
EMAIL_FROM_NAME=PackageGuard

# ── Optional AI image analysis (disabled by default) ──────────────────────────
AI_ANALYSIS_ENABLED=false
# AI_ANALYSIS_PROVIDER=anthropic    # 'anthropic' or 'openai'
# ANTHROPIC_API_KEY=sk-ant-...      # required if provider=anthropic
# OPENAI_API_KEY=sk-...             # required if provider=openai
