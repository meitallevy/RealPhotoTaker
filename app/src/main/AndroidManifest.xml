<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".PackageGuardApp"
        android:allowBackup="true"
        android:icon="@android:mipmap/sym_def_app_icon"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Entry point -->
        <activity
            android:name=".presentation.splash.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Role selection -->
        <activity
            android:name=".presentation.role.RoleSelectionActivity"
            android:exported="false" />

        <!-- Auth -->
        <activity
            android:name=".presentation.auth.LoginActivity"
            android:exported="false" />

        <activity
            android:name=".presentation.auth.RegisterActivity"
            android:exported="false" />

        <!-- Seller screens -->
        <activity
            android:name=".presentation.seller.SellerDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".presentation.seller.SellerClaimsActivity"
            android:exported="false" />

        <activity
            android:name=".presentation.seller.SellerClaimDetailActivity"
            android:exported="false" />

        <!-- Claim flow — ClaimEntryActivity handles the packageguard:// deep link -->
        <activity
            android:name=".presentation.claim.ClaimEntryActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="packageguard"
                    android:host="claim" />
            </intent-filter>
        </activity>

        <activity
            android:name=".presentation.claim.GuidedCaptureActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".presentation.claim.ReviewSubmitActivity"
            android:exported="false" />

        <activity
            android:name=".presentation.claim.ConfirmationActivity"
            android:exported="false" />

        <!-- Services -->
        <service
            android:name=".service.UploadService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <service
            android:name=".service.FCMService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>
