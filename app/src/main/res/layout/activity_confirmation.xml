<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✓ Submitted!"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#2e7d32"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your package evidence has been securely recorded."
        android:textSize="15sp"
        android:textColor="#444444"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/textConfirmClaimId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Claim ID: clm_xxxxxx"
        android:textSize="15sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/textConfirmStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: PROCESSING"
        android:textSize="14sp"
        android:textColor="#555555"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Verification URL:"
        android:textSize="13sp"
        android:textColor="#888888"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/textVerifyUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="https://verify.packageguard.io/..."
        android:textSize="13sp"
        android:textColor="#1565C0"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/buttonCopyUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Copy Verification URL"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/buttonDone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Done" />

</LinearLayout>
